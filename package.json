{
  "name": "ado-board",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A fast, focused Azure DevOps backlog & sprint board (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icons": "swift scripts/generate-icons.swift",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node scripts/fix-electron-signature.mjs",
    "dist": "electron-vite build && electron-builder --mac",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "prepare": "husky"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "csstype": "3.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "productName": "ADO Board",
  "private": true,
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
